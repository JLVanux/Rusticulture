# Copier ce fichier en .env.local et coller les deux valeurs données par
# Supabase : bouton « Connect » en haut du tableau de bord, onglet Framework,
# encadré .env.local.
#
# Sans ces variables, le site fonctionne normalement : seule la partie ferme
# est désactivée.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Ancien nom, toujours accepté si ton projet date d'avant le renommage :
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Notifications Discord (serveur uniquement) ---------------------------
# Ces deux variables ne portent PAS le préfixe NEXT_PUBLIC_ : elles ne doivent
# jamais atteindre le navigateur.
#
# La clé de service contourne toutes les politiques de la base. Elle se trouve
# dans Supabase → Project Settings → API, section « service_role ».
SUPABASE_SERVICE_ROLE_KEY=
# Une chaîne aléatoire de ton choix, à recopier à l'identique dans les secrets
# GitHub. Elle protège la route d'envoi contre les appels de n'importe qui.
CRON_SECRET=
